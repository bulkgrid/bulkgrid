{
  "name": "bulkgrid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "check:types": "npm run check-types --workspaces --if-present",
    "lint": "eslint packages/sdk/src packages/cli/src",
    "docs:check": "node docs/scripts/checkDocs.mjs",
    "openapi:generate": "node scripts/generateOpenApi.mjs",
    "check": "npm run build && npm run check:types && npm test && npm run lint && npm run docs:check && npm run export:check",
    "export:check": "node scripts/checkExport.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsdown": "0.22.14",
    "vitest": "4.1.10",
    "@types/node": "25.9.3",
    "eslint": "9.39.2",
    "@eslint/js": "9.39.2",
    "typescript-eslint": "8.56.0",
    "globals": "17.2.0",
    "prettier": "3.8.4"
  }
}
