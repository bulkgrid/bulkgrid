{
  "name": "@bulkgrid/cli",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bulkgrid/bulkgrid.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "bulkgrid": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node --import tsx ../../scripts/cliSkills.ts --build && tsdown",
    "prepack": "node --import tsx ../../scripts/cliSkills.ts --check",
    "lint": "eslint src",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,js,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,md}\""
  },
  "dependencies": {
    "@inquirer/prompts": "7.10.1",
    "commander": "14.0.3",
    "zod": "4.4.3",
    "@bulkgrid/sdk": "^0.4.0"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  }
}
