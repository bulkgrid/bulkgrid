{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bulkgrid",
  "seo": {
    "metatags": {
      "canonical": "https://bulkgrid.com/docs"
    }
  },
  "colors": {
    "primary": "#4F8968",
    "light": "#4F8968",
    "dark": "#4F8968"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["getting-started", "sdk", "cli", "mcp-server"]
          },
          {
            "group": "Index",
            "pages": ["sources", "collections", "index"]
          },
          {
            "group": "More",
            "pages": ["search", "map", "crawl", "deep-crawl", "extraction", "runs-and-results", "examples"]
          },
          {
            "group": "Access and operations",
            "pages": [
              "authentication",
              "api-key-scopes",
              "plan-gating-and-limits",
              "usage-metrics",
              "reliability-and-retries",
              "troubleshooting",
              "security-and-data-handling",
              "versioning"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["overview"]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/bulkgrid",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "href": "https://bulkgrid.com",
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@bulkgrid.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://bulkgrid.com/auth/login"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/bulkgrid",
      "github": "https://github.com/bulkgrid",
      "linkedin": "https://linkedin.com/company/bulkgrid"
    }
  },
  "redirects": [
    {
      "source": "/web-search",
      "destination": "/search"
    },
    {
      "source": "/guides/github-sources",
      "destination": "/sources"
    },
